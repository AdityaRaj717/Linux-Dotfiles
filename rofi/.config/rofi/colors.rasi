* {
    /* Catppuccin_Mocha Rofi Palette */

    /* Backgrounds */
    background:     #1e1e2e;
    surface:        #313244;
    
    /* Text */
    on-background:  #cdd6f4;
    on-surface:     #cdd6f4;
    text-dim:       #6c7086;

    /* Primary Selection (Mauve Box / Dark Text) */
    primary:        #cba6f7;
    on-primary:     #1e1e2e;
    
    /* Secondary (Blue) */
    secondary:      #89b4fa;
    on-secondary:   #1e1e2e;

    /* Status */
    active:         #cba6f7;
    selected:       #cba6f7;
    urgent:         #f38ba8;
    error:          #f38ba8;
    on-error:       #1e1e2e;

    /* Borders */
    border-col:     #45475a;
    separator:      #45475a;
}
