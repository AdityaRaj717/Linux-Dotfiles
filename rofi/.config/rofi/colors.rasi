* {
    /* Tokyo_Night Rofi Palette */

    /* Backgrounds */
    background:     #1a1b26;
    surface:        #24283b;
    
    /* Text */
    on-background:  #c0caf5;
    on-surface:     #c0caf5;
    text-dim:       #565f89;

    /* Primary Selection (Cyan Box / Dark Text) */
    primary:        #7dcfff;
    on-primary:     #15161e;
    
    /* Secondary (Purple) */
    secondary:      #bb9af7;
    on-secondary:   #15161e;

    /* Status */
    active:         #7dcfff;
    selected:       #7dcfff;
    urgent:         #f7768e;
    error:          #f7768e;
    on-error:       #c0caf5;

    /* Borders */
    border-col:     #565f89;
    separator:      #565f89;
}
