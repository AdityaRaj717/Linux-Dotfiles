* {
    /* Green_Lush Rofi Palette */

    /* Backgrounds */
    background:     #0a0f0d;
    surface:        #18211b;
    
    /* Text */
    on-background:  #e0e6e2;
    on-surface:     #e0e6e2;
    text-dim:       #3d4f43;

    /* Primary Selection (Sage Box / Dark Text) */
    primary:        #7cac8a;
    on-primary:     #0a0f0d;
    
    /* Secondary (Matcha) */
    secondary:      #a3c9a8;
    on-secondary:   #0a0f0d;

    /* Status */
    active:         #7cac8a;
    selected:       #7cac8a;
    urgent:         #d48c8c;
    error:          #d48c8c;
    on-error:       #e0e6e2;

    /* Borders */
    border-col:     #3d4f43;
    separator:      #3d4f43;
}
