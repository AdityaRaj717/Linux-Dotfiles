* {
    /* Scarlet_Night Rofi Palette */

    /* Backgrounds */
    background:     #121214;
    surface:        #27272a;
    
    /* Text */
    on-background:  #e5e5ea;
    on-surface:     #e5e5ea;
    text-dim:       #3f3f46;

    /* Primary Selection (Red Box / White Text) */
    primary:        #d63a4a;
    on-primary:     #ffffff;
    
    /* Secondary (Steel) */
    secondary:      #9e9ea0;
    on-secondary:   #121214;

    /* Status */
    active:         #d63a4a;
    selected:       #d63a4a;
    urgent:         #d63a4a;
    error:          #d63a4a;
    on-error:       #ffffff;

    /* Borders */
    border-col:     #3f3f46;
    separator:      #3f3f46;
}
