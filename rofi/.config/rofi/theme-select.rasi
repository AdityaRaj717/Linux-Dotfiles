/*******************************************************************************
 * ROFI THEME SELECTOR - ENHANCED COLORS
 *******************************************************************************/

@import "colors.rasi"

configuration {
    show-icons: true;
}

* {
    /* Using proper color variables from colors.rasi */
    bg: @background;
    bg-alt: @surface;
    
    accent: @primary;
    accent-alt: @secondary;
    text: @on-surface;
    text-dim: @text-dim;
    
    background-color: transparent;
    text-color: @text;
}

window {
    location: center;
    width: 1200px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 16px;
    padding: 32px;
}

mainbox {
    spacing: 24px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 16px;
    padding: 20px 24px;
    /* Rich dark surface for input area */
    background-color: @bg-alt;
    border-radius: 12px;
    border: 1px solid;
    border-color: @border-col;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "GeistMono Nerd Font Propo Bold 13";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search themes...";
    placeholder-color: @text-dim;
    font: "GeistMono Nerd Font Propo Medium 11";
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 3;
    lines: 2;
    spacing: 24px;
    scrollbar: false;
    cycle: true;
    dynamic: true;
    fixed-height: true;
    fixed-columns: true;
}

element {
    padding: 16px;
    /* Subtle elevated surface */
    background-color: @bg-alt;
    border-radius: 12px;
    border: 1px solid;
    border-color: @border-col;
    orientation: vertical;
}

element selected {
    /* Bold accent highlight for selected items */
    background-color: @bg-alt;
    border: 3px solid;
    border-color: @accent;
    /* Add subtle glow effect */
}

element-icon {
    size: 200px;
    horizontal-align: 0.5;
    margin: 0px 0px 16px 0px;
    border-radius: 8px;
}

element-text {
    horizontal-align: 0.5;
    text-color: @text;
    font: "GeistMono Nerd Font Propo Bold 12";
}

element selected.normal element-text {
    text-color: @accent;
}

